<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.Base" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/warzone_brand_background</item>
        <item name="android:colorAccent">@color/warzone_text</item>
        <item name="android:colorBackground">@color/warzone_brand_background</item>
        <item name="android:textColorPrimary">@color/warzone_text</item>
        <item name="android:textColorSecondary">@color/warzone_secondary</item>
        <item name="android:textColorHint">@color/warzone_disabled</item>
        <item name="android:colorControlNormal">@color/warzone_text</item>
        <item name="android:colorControlActivated">@color/warzone_text</item>
        <item name="android:colorControlHighlight">#22FFFFFF</item>
        <item name="android:colorButtonNormal">@color/warzone_control</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/warzone_brand_background</item>
        <item name="android:statusBarColor">@color/warzone_brand_background</item>
    </style>
    <style name="AppTheme" parent="AppTheme.Base" />
</resources>
