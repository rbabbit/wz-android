+// Towers opts in with the existing transient UI marker; never saved to disk.
+static bool towersSageTheme()
+{
+#ifdef __EMSCRIPTEN__
+	FILE *marker = fopen("/tmp/warzone-towers-ui-v34", "rb");
+	if (!marker) return false;
+	const bool enabled = fgetc(marker) == '1';
+	fclose(marker);
+	return enabled;
+#else
+	return false;
+#endif
+}
+
+static PIELIGHT towersSageColour(uint8_t r, uint8_t g, uint8_t b)
+{
+	PIELIGHT colour;
+	colour.fromRGBA(r, g, b, 255);
+	return colour;
+}
+
+static void towersConsoleBoxFill(int x1, int y1, int x2, int y2)
+{
+	if (towersSageTheme()) pie_UniTransBoxFill(x1, y1, x2, y2, towersSageColour(220,232,207));
+	else iV_TransBoxFill(x1, y1, x2, y2);
+}
 
