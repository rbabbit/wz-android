+// The Towers WebView uses middle-button presses only for touch-camera drags.
+// A rapid second swipe must remain a held drag, not the desktop double-click
+// state that inputNewFrame clears even while the finger is still down.
+static bool towersTouchMiddleDrag()
+{
+#if defined(__EMSCRIPTEN__)
+	FILE *marker = std::fopen("/tmp/warzone-towers-ui-v34", "rb");
+	if (!marker) return false;
+	const bool enabled = std::fgetc(marker) == '1';
+	std::fclose(marker);
+	return enabled;
+#else
+	return false;
+#endif
+}
