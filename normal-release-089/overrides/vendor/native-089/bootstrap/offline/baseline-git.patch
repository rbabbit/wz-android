+static void towersIntelligenceReset()
+{
+	towersIntelStopAudio();
+	towersIntel = TowersIntelState{};
+	remove("/tmp/warzone-towers-intelligence-command.json");
+	remove("/tmp/warzone-towers-intelligence-state.json");
+}
