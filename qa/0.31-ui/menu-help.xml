 /><node index="2" text="LARGE" resource-id="" class="android.widget.ToggleButton" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[241,213][309,261]" drawing-order="0" hint="" /><node index="3" text="EXTRA LARGE" resource-id="" class="android.widget.ToggleButton" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[316,213][430,261]" drawing-order="0" hint="" /></node><node index="2" text="" resource-id="" class="android.view.View" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[15,267][1080,600]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[39,288][532,600]" drawing-order="0" hint=""><node index="0" text="DEFEND &amp; SURVIVE" resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[39,288][532,318]" drawing-order="0" hint="" /><node index="1" text="Protect your Command Centre; losing it ends the battle. You have 4 minutes to prepare before Wave 1 starts automatically. Survive 15 rounds and clear the final enemies to win." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[39,328][532,438]" drawing-order="0" hint="" /><node index="2" text="Waves follow their own timer, even while enemies remain. During a countdown, SKIP WAVE calls the next wave early; it does not clear enemies. Destroying enemies earns power." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[39,448][532,531]" drawing-order="0" hint="" /></node><node index="1" text="" resource-id="" class="android.view.View" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[564,288][1057,600]" drawing-order="0" hint=""><node index="0" text="CRYSTALS &amp; MATCH BOOSTS" resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[564,288][1057,318]" drawing-order="0" hint="" /><node index="1" text="REWARDS on Home shows your saved phone wallet and portable inventory. A new wallet starts with 350 crystals. Each actually completed wave earns 5 crystals, saved once even if you later lose. Waves can overlap; starting or skipping a wave earns nothing. A win also pays 60 / 80 / 100 on Easy / Medium / Hard, plus 50 for that map's first completion. The final receipt includes crystals already earned during play." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[564,328][1057,519]" drawing-order="0" hint="" /><node index="2" text="On Home use Shop to buy stock and Next match to choose how many to take. In-game REWARDS buys boosts for the current match immediately. Purchases work on any map. Bulk quantities include 5, 10, 15, 20 and +5. You can take up to three fortresses combined. Every purchased structure still uses its normal in-game power cost." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[564,529][1057,600]" drawing-order="0" hint="" /><node index="3" text="SAVE keeps the current native game on your phone. Open Saved Games on Home to load or delete it. Saved matches retain their wave credits, purchases and used allowances; reloading pays no crystals twice. Unused stock in a saved match stays reserved until its last save is deleted." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="4" text="A building purchase is used when its foundation appears, including if it is later destroyed. Unused building stock returns after the match or a confirmed return Home. Research accelerator adds 25% speed while you choose topics; Supply reserve adds 1,000 starting power. These two boosts are used when the match starts." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /></node><node index="2" text="" resource-id="" class="android.view.View" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint=""><node index="0" text="LASER SATELLITE" resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="1" text="The Laser Satellite Command Post is a weapon, separate from your Satellite Uplink. Build and complete the post, tap it on the battlefield to select it, then press FIRE SAT and tap a visible enemy unit or building. Its native recharge time is shown in the header. Press CANCEL SAT or Back to cancel targeting." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /></node><node index="3" text="" resource-id="" class="android.view.View" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint=""><node index="0" text="BUILD WITH YOUR TRUCKS" resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="1" text="BUILD selects construction trucks visible in your view. Choose a structure, then tap valid locations to queue sites. For walls, gates, towers and hardpoints, drag a straight line and release to queue the clear sites shown in the preview. Factories, labs, power generators and modules stay single placements. Green blueprints mark accepted orders. Your manually selected truck group is kept when choosing structures." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="2" text="For another area, move the view and use TRUCKS to select its visible trucks. EXIT · KEEP ORDERS or SELECT / MOVE leaves placement while trucks continue. STOP cancels selected trucks’ work and remaining sites." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /></node><node index="4" text="" resource-id="" class="android.view.View" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint=""><node index="0" text="UPGRADE WITH MODULES" resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="1" text="In BUILD → MODULES, choose an upgrade and tap a highlighted, completed matching building: Research Module → research lab; Power Module → power generator; Factory Module → vehicle or VTOL factory." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="2" text="Labs and power generators each take one module; vehicle and VTOL factories take two. Highlights show ready, upgrading or full buildings. Finish the matching structure or research the module first if none is ready." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /></node><node index="5" text="" resource-id="" class="android.view.View" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint=""><node index="0" text="CHOOSE YOUR RESEARCH" resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="1" text="Top RESEARCH opens the full page. Choose a lab and tap one or more available topics. Numbers show your selection order; tap a selected topic again to deselect it. ADD TO LAB … QUEUE adds the selection in that order. Each lab follows its own queue. Use × to remove a waiting topic." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="2" text="Tap one of your completed labs on the battlefield to open that lab’s full research page." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /></node><node index="6" text="" resource-id="" class="android.view.View" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint=""><node index="0" text="CHECK CURRENT ACTIVITY" resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="1" text="Bottom-left RESEARCH and PRODUCTION open narrow status panels while you watch the battlefield. Research shows each lab’s current topic and estimated progress; Production shows current units, with vehicle and cyborg tabs." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="2" text="These panels show current work only. Use top RESEARCH or PRODUCTION to change queues. Tap the selected footer button again or × to close the panel." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /></node><node index="7" text="" resource-id="" class="android.view.View" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint=""><node index="0" text="MAKE UNITS IN A FACTORY" resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="1" text="Open top PRODUCTION, or tap one of your completed factories on the battlefield. Select the intended factory, choose QUANTITY (1, 5, 10 or 20), then PRODUCE a compatible design. Orders belong to the selected factory. Use UNITS, DESIGN and BLUEPRINTS inside Production to switch tasks." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="2" text="Production uses normal power and build time. Research, factory type, modules and unit limits still apply. The full page shows current work and waiting units; QUEUE shows wider activity." resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /></node><node index="8" text="" resource-id="" class="android.view.View" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint=""><node index="0" text="KEEP YOUR BLUEPRINTS" resource-id="" class="android.widget.TextView" package="com.rbabbit.warzonetowers.lab" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="1" text="In PRODUCTION → DESIGN, choose a researched body, propulsion and weapon or system; name it and SAVE B